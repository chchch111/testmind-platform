# =========================
# 基础服务配置
# =========================
APP_NAME=RAG思维导图测试用例平台
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# =========================
# MySQL数据库配置
# 注意：这里先写示例值，你需要改成自己电脑/服务器的MySQL账号密码
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=rag_mindmap_test_platform

# =========================
# 文件存储配置
# 留空则默认使用项目根目录下的 storage/ 子目录：
#   storage/faiss、storage/uploads、storage/exports
# 如需自定义目录（例如云服务器 /opt/rag_mindmap_platform/storage/faiss），在此填写
# =========================
FAISS_ROOT_DIR=
UPLOAD_ROOT_DIR=
EXPORT_ROOT_DIR=

# =========================
# RAG知识库配置
# bge-small-zh在应用服务内部运行，可部署本机CPU或云服务器CPU
# =========================
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 留空则默认使用 storage/models/huggingface
HF_HOME=
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5

# =========================
# DeepSeek云端API配置
# 代码中严禁硬编码API Key，只能从环境变量读取
# =========================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# =========================
# 登录认证配置
# 生产环境务必改成随机长字符串，不要使用默认值
# =========================
AUTH_SECRET_KEY=rag-mindmap-dev-secret-change-me
AUTH_TOKEN_EXPIRE_MINUTES=1440

# =========================
# 跨域配置
# 逗号分隔的允许来源；留空默认放行前端开发地址 http://127.0.0.1:5173
# =========================
CORS_ORIGINS=

# =========================
# 上传限制
# XMind 导入、知识库文件上传的最大体积（MB）
# =========================
MAX_UPLOAD_MB=20

