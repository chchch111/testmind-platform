# =========================
# 基础服务配置
# =========================
APP_NAME=RAG思维导图测试用例平台
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# =========================
# MySQL数据库配置
# 注意：这里先写示例值，后面你需要改成自己电脑上的MySQL账号密码
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=rag_mindmap_test_platform

# =========================
# 文件存储配置
# 所有项目文件统一放D盘，方便后续云服务器迁移时集中修改
# =========================
FAISS_ROOT_DIR=D:/csdn_projects/rag_mindmap_platform/storage/faiss
UPLOAD_ROOT_DIR=D:/csdn_projects/rag_mindmap_platform/storage/uploads
EXPORT_ROOT_DIR=D:/csdn_projects/rag_mindmap_platform/storage/exports

# =========================
# RAG知识库配置
# bge-small-zh在应用服务内部运行，可部署本机CPU或云服务器CPU
# =========================
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
HF_HOME=D:/csdn_projects/rag_mindmap_platform/storage/models/huggingface
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5

# =========================
# DeepSeek云端API配置
# 代码中严禁硬编码API Key，只能从环境变量读取
# =========================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
